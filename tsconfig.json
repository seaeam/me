{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "paths": {
      "@/*": ["./src/*"],
      "@content/*": ["./content/*"]
    },
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"]
  },
  "include": [
    "src/**/*",
    "api/**/*.ts",
    "build/**/*.ts",
    "server/**/*.ts",
    "vite.config.ts",
    "vitest.config.ts",
    "uno.config.ts"
  ]
}
